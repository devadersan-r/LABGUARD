# LabGuard Local Backend Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Local SQLite Database
DATABASE_URL=sqlite:///./data/labguard.db

# Path to LabGuard Key Store (relative to backend or absolute)
KEYSTORE_PATH=../LABGUARD/keys/labguard_keys.json

# Serial Communication Defaults
DEFAULT_BAUD_RATE=115200
DEFAULT_SERIAL_TIMEOUT_SECONDS=1.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Gmail SMTP Tamper Alert Configuration (STARTTLS port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dpgaming292@gmail.com
SMTP_PASSWORD=PASTE_MY_NEW_GMAIL_APP_PASSWORD_HERE
SMTP_FROM_EMAIL=dpgaming292@gmail.com
TAMPER_ALERT_TO=labgaurd@gmail.com
SMTP_USE_TLS=true
